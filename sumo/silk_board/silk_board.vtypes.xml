<?xml version="1.0" encoding="UTF-8"?>
<!--
Vehicle types for the Silk Board Junction digital twin, reflecting Bangalore's
real traffic mix (motorcycle/two-wheeler dominant, with autos, cars, buses, trucks).
Referenced by silk_board.sumocfg as an additional file.
-->
<additional>
    <vType id="motorcycle" vClass="motorcycle" length="2.0" width="0.8" minGap="1.0"
           maxSpeed="20" accel="3.0" decel="5.0" sigma="0.8" guiShape="motorcycle" color="0.9,0.6,0.1"/>
    <vType id="auto_rickshaw" vClass="taxi" length="2.6" width="1.3" minGap="1.5"
           maxSpeed="14" accel="1.8" decel="4.5" sigma="0.7" guiShape="delivery" color="0.1,0.7,0.9"/>
    <vType id="car" vClass="passenger" length="4.2" width="1.8" minGap="2.0"
           maxSpeed="16" accel="2.2" decel="4.5" sigma="0.6" guiShape="passenger" color="0.2,0.5,0.9"/>
    <vType id="bus" vClass="bus" length="10.5" width="2.5" minGap="2.5"
           maxSpeed="13" accel="1.2" decel="4.0" sigma="0.5" guiShape="bus" color="0.9,0.2,0.2"/>
    <vType id="truck" vClass="truck" length="8.0" width="2.4" minGap="2.5"
           maxSpeed="14" accel="1.3" decel="4.0" sigma="0.5" guiShape="truck" color="0.5,0.5,0.5"/>
</additional>
